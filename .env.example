# Copy to .env and fill in values. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transport_crm
JWT_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
API_PORT=4000
TZ=Africa/Lagos

# Embedded Postgres (local dev without Docker). Ignored when Docker/external Postgres is used.
PGDATA_DIR=
PG_PORT=5432

# WhatsApp
WHATSAPP_PROVIDER=console            # console | meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_MANIFEST=transport_manifest
WHATSAPP_TEMPLATE_UPDATE=transport_manifest_update
WHATSAPP_TEMPLATE_REMINDER=transport_confirm_reminder
WHATSAPP_TEMPLATE_LANG=en
